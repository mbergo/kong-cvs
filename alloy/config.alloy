// Scrape the Kong data plane status endpoint and push to Grafana Cloud Prometheus.
prometheus.scrape "kong" {
  targets = [{
    __address__ = "127.0.0.1:" + sys.env("KONG_STATUS_PORT"),
    job         = "kong",
    instance    = constants.hostname,
  }]
  scrape_interval = "15s"
  forward_to      = [prometheus.remote_write.grafana_cloud.receiver]
}

prometheus.remote_write "grafana_cloud" {
  endpoint {
    url = sys.env("GRAFANA_PROM_URL")
    basic_auth {
      username = sys.env("GRAFANA_PROM_USER")
      password = sys.env("GRAFANA_PROM_TOKEN")
    }
  }
}
