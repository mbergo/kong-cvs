# Konnect data plane settings (non-secret). Secrets live in secrets/ (gitignored).
KONG_IMAGE=kong/kong-ai-gateway:2.2.0-distroless
KONG_CONTAINER_NAME=kong-dp
KONNECT_CP_HOST=c0b1bf91b1.us.cp.konghq.com
KONNECT_TP_HOST=c0b1bf91b1.us.tp.konghq.com
KONG_PROXY_PORT=8000
KONG_PROXY_TLS_PORT=8443
# Status API + /metrics, bound to localhost only
KONG_STATUS_PORT=8100
# TEST ONLY: "off" lets plugins with ssl_verify=false sync (Konnect rejects the whole config otherwise). Use "on" in prod.
KONG_TLS_CERTIFICATE_VERIFY=off
CLUSTER_CERT_FILE=secrets/cluster.crt
CLUSTER_KEY_FILE=secrets/cluster.key

# Konnect API (step 02). Token in secrets/konnect.env as KONNECT_TOKEN=kpat_...
KONNECT_API=https://us.api.konghq.com

# Grafana Alloy (step 03). Credentials in secrets/grafana.env:
#   GRAFANA_PROM_URL=https://prometheus-prod-XX-....grafana.net/api/prom/push
#   GRAFANA_PROM_USER=<numeric instance id>
#   GRAFANA_PROM_TOKEN=glc_...
GRAFANA_ALLOY_IMAGE=grafana/alloy:latest
GRAFANA_ALLOY_CONTAINER_NAME=grafana-alloy
